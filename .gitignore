# Python caches, local environments, and tooling
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Secrets: only the shared Streamlit theme configuration is versioned
.env
.env.*
!.env.example
!.env.template
/.streamlit/*
!/.streamlit/config.toml
*.pem
*.key

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.swp
*.swo
*.tmp
*.bak

# Generated predictions, experiments, QA files, and local uploads
/docs/
/artifacts/
/runs/
/experiments/
/outputs/
/uploads/
/user_uploads/
/dataset/
/datasets/
/data/
/test-results/
/playwright-report/
node_modules/
*.log
*.cache

# Dataset archives and exported model formats
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.pt
*.pth
*.onnx
*.engine
*.tflite

# Keep only the checkpoint used by the model with negative samples
/models/*
!/models/best.pt

# Training exports are local; allow only application runtime dependencies
/YOLO26s_seg/*
!/YOLO26s_seg/02_hasil_training/
!/YOLO26s_seg/03_hasil_evaluasi/

/YOLO26s_seg/03_hasil_evaluasi/*
!/YOLO26s_seg/03_hasil_evaluasi/YOLO26s_seg_official_test_metrics.csv
!/YOLO26s_seg/03_hasil_evaluasi/YOLO26s_seg_per_class_metrics.csv
!/YOLO26s_seg/03_hasil_evaluasi/YOLO26s_seg_no_tumor_fp_summary.csv

/YOLO26s_seg/02_hasil_training/*
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/
/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/*
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/weights/
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/03_hasil_evaluasi/

/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/weights/*
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/weights/best.pt

/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/03_hasil_evaluasi/*
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/03_hasil_evaluasi/yolo26s_seg_tanpa_no_tumor_official_test_metrics.csv
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/03_hasil_evaluasi/yolo26s_seg_tanpa_no_tumor_per_class_metrics.csv
!/YOLO26s_seg/02_hasil_training/YOLO26s_seg_tanpa_no_tumor/03_hasil_evaluasi/yolo26s_seg_tanpa_no_tumor_no_tumor_fp_summary.csv

# Small sample images remain available for browser tests; labeled datasets stay local
/samples/labeled_dataset_sample/
